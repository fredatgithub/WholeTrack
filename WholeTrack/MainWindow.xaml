<Window x:Class="WholeTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WholeTrack"
        mc:Ignorable="d"
        Title="Time track of geniuses" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: add person -->
        <StackPanel Grid.Column="0" Margin="8" VerticalAlignment="Top">
            <TextBlock x:Name="FormHeaderTextBlock" FontWeight="Bold" FontSize="14" Text="Ajouter un personnage" Margin="0,0,0,8" />

            <TextBlock Text="Nom" />
            <TextBox x:Name="LastNameTextBox" />

            <TextBlock Text="Prénom" Margin="0,6,0,0" />
            <TextBox x:Name="FirstNameTextBox" />

            <TextBlock Text="Occupation" Margin="0,6,0,0" />
            <TextBox x:Name="OccupationTextBox" />

            <TextBlock Text="Genre" Margin="0,6,0,0" />
            <ComboBox x:Name="GenderComboBox" SelectedIndex="0" Width="140">
                <ComboBoxItem Content="Homme" />
                <ComboBoxItem Content="Femme" />
            </ComboBox>

            <TextBlock Text="Date de naissance" Margin="0,6,0,0" />
            <DatePicker x:Name="BirthDatePicker" SelectedDate="1900-01-01" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="BirthUnknownCheckBox" Content="Inconnue" VerticalAlignment="Center" Checked="BirthUnknownCheckBox_Checked" Unchecked="BirthUnknownCheckBox_Unchecked" />
                <CheckBox x:Name="BirthBCCheckBox" Content="Avant J.-C." VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox x:Name="IsDeadCheckBox" VerticalAlignment="Center" Content="Décédé" Checked="IsDeadCheckBox_Checked" Unchecked="IsDeadCheckBox_Unchecked" />
                <TextBlock Text="Date de décès" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <DatePicker x:Name="DeathDatePicker" IsEnabled="False" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="DeathUnknownCheckBox" Content="Inconnue" VerticalAlignment="Center" Checked="DeathUnknownCheckBox_Checked" Unchecked="DeathUnknownCheckBox_Unchecked" />
                <CheckBox x:Name="DeathBCCheckBox" Content="Avant J.-C." VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="AddButton" Content="Ajouter" Width="100" Click="AddButton_Click" />
                <Button x:Name="CancelEditButton" Content="Annuler" Width="100" Margin="12,0,0,0" Click="CancelEditButton_Click" Visibility="Collapsed" />
            </StackPanel>

        </StackPanel>

        <!-- Right: timeline with zoom slider -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="ZoomSlider" Minimum="0.2" Maximum="3" Value="1" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" Width="200" ValueChanged="ZoomSlider_ValueChanged" />
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
                <ScrollViewer x:Name="TimelineScrollViewer" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                    <Canvas x:Name="TimelineCanvas" MinHeight="200" Background="White" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
